# build output (includes build/GrimDawn.unpacked.bin, a dump of the game's own code -- never commit)
build/
*.pdb
*.obj
*.ilk
*.exp

# reference clones of other projects (have their own git history)
reference/

# prebuilt prism SDK: only the parts the build uses are committed (headers, x64 import lib + dll, licenses);
# the rest of the 1.1 GB release stays ignored. See third_party/README.md.
third_party/prism-bin/*
!third_party/prism-bin/prism-sdk-v0.18.1/
third_party/prism-bin/prism-sdk-v0.18.1/*
!third_party/prism-bin/prism-sdk-v0.18.1/include/
!third_party/prism-bin/prism-sdk-v0.18.1/LICENSES/
!third_party/prism-bin/prism-sdk-v0.18.1/NOTICE
!third_party/prism-bin/prism-sdk-v0.18.1/windows/
third_party/prism-bin/prism-sdk-v0.18.1/windows/*
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/
third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/*
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/
third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/*
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/
third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/*
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/lib/
third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/lib/*
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/lib/prism.lib
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/bin/
third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/bin/*
!third_party/prism-bin/prism-sdk-v0.18.1/windows/x64/dynamic/release/bin/prism.dll
third_party/prism/

# editor / OS noise
.vs/
.vscode/
*.swp
Thumbs.db

# uv project environment
.venv/
__pycache__/
__pycache__/
*.pyc

.env
